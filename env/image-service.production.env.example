# 生产环境模板。复制为项目根目录 `.env.production` 后填入真实值；不要提交真实密钥。

# 目标链路：
# https://image.lihao66.top -> VPS Caddy -> Tailscale -> Mac mini image-service:3010
NEXT_PUBLIC_APP_URL="https://image.lihao66.top"

# Supabase Auth。anon key 会进入浏览器 bundle；不要填写 service role key。
NEXT_PUBLIC_SUPABASE_URL="https://supabase.lihao66.top"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-public-anon-key"

# Provider allowlist。客户端只能看到公开投影，baseUrl 和 apiKeyEnv 只在服务端使用。
IMAGE_DEFAULT_PROVIDER="sub2api"
IMAGE_DEFAULT_MODEL="gpt-image-2"
IMAGE_DEFAULT_SIZE="1024x1536"
IMAGE_DEFAULT_QUALITY="high"
IMAGE_DEFAULT_OUTPUT_FORMAT="png"
IMAGE_PROVIDER_OPTIONS='[{"id":"sub2api","label":"Sub2API","type":"openai-compatible-images","baseUrl":"https://sub2api.toioto.org/v1","apiKeyEnv":"SUB2API_API_KEY","models":["gpt-image-2"]}]'
SUB2API_API_KEY="replace-with-provider-api-key"

# 用户可选参数和每日额度。
IMAGE_SIZE_OPTIONS="1024x1024,1024x1536,1536x1024"
IMAGE_QUALITY_OPTIONS="high,medium,low"
IMAGE_OUTPUT_FORMAT_OPTIONS="png,jpeg,webp"
IMAGE_DAILY_LIMIT="20"

# SQLite 生产路径。Compose 会挂载宿主机 `/Users/hao/Desktop/lihao-data/image-service` 到容器 `/data`。
IMAGE_SERVICE_SQLITE_PATH="/data/sqlite/image-service.sqlite"
