# 本地容器模板。复制为项目根目录 `.env.local` 或按需通过 Compose env_file 使用。
# 不要提交真实 Supabase key、provider key 或本地数据库。

NEXT_PUBLIC_APP_URL="http://localhost:3010"

# Supabase Auth。anon key 会进入浏览器 bundle；不要填写 service role key。
NEXT_PUBLIC_SUPABASE_URL="https://supabase.lihao66.top"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-public-anon-key"

# Provider allowlist。客户端只能看到公开投影，baseUrl 和 apiKeyEnv 只在服务端使用。
IMAGE_DEFAULT_PROVIDER="toioto"
IMAGE_DEFAULT_MODEL="gpt-image-2"
IMAGE_PROVIDER_OPTIONS='[{"id":"toioto","label":"Toioto","type":"openai-compatible-images","baseUrl":"https://sub2api.toioto.org/v1","apiKeyEnv":"SUB2API_API_KEY","models":[{"id":"gpt-image-2","label":"GPT Image 2","family":"chatgpt","enabled":true,"supportsTextToImage":true,"supportsImageToImage":true}]},{"id":"fastcode","label":"FastCode","type":"openai-compatible-images","baseUrl":"https://timebackward.com/v1","apiKeyEnv":"FASTCODE_API_KEY","models":[{"id":"gpt-image-2-2k","label":"GPT Image 2 2K","family":"chatgpt","enabled":true,"supportsTextToImage":true,"supportsImageToImage":true},{"id":"gpt-image-2-4k","label":"GPT Image 2 4K","family":"chatgpt","enabled":true,"supportsTextToImage":true,"supportsImageToImage":true}]},{"id":"fastcode-gemini","label":"FastCode Gemini","type":"gemini-generate-content","baseUrl":"https://timebackward.com/v1beta","apiKeyEnv":"FASTCODE_API_KEY","authStyle":"api-key-header","models":[{"id":"gemini-3.1-flash-image-preview","label":"Gemini 3.1 Flash","family":"gemini","enabled":true,"supportsTextToImage":true,"supportsImageToImage":true}]}]'
SUB2API_API_KEY="replace-with-provider-api-key"
FASTCODE_API_KEY=""
MINIMAX_API_KEY=""

# 每日额度。
IMAGE_DAILY_LIMIT="20"

# 本地容器路径。Compose 会挂载宿主机 `/Users/hao/Desktop/lihao-data/image-service` 到容器 `/data`。
IMAGE_SERVICE_SQLITE_PATH="/data/sqlite/image-service.sqlite"
