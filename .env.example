# 仅填写本地或部署环境自己的值；不要提交真实密钥。

# Supabase Auth。只填写自己环境的 URL 和 anon key；不要提交真实值。
# 登录边界只使用 anon key 和服务端 cookie session，不需要 service role key。
NEXT_PUBLIC_SUPABASE_URL="https://你的-supabase-域名"
NEXT_PUBLIC_SUPABASE_ANON_KEY="你的-supabase-anon-key"

# image-service 服务端配置，由 src/lib/config/ 解析和校验。
IMAGE_DEFAULT_PROVIDER="toioto"
IMAGE_DEFAULT_MODEL="gpt-image-2"
IMAGE_PROVIDER_OPTIONS='[{"id":"toioto","label":"Toioto","type":"openai-compatible-images","baseUrl":"https://sub2api.toioto.org/v1","apiKeyEnv":"SUB2API_API_KEY","models":[{"id":"gpt-image-2","label":"GPT Image 2","family":"chatgpt","enabled":true,"supportsTextToImage":true,"supportsImageToImage":true}]},{"id":"fastcode","label":"FastCode","type":"openai-compatible-images","baseUrl":"https://timebackward.com/v1","apiKeyEnv":"FASTCODE_API_KEY","models":[{"id":"gpt-image-2-2k","label":"GPT Image 2 2K","family":"chatgpt","enabled":true,"supportsTextToImage":true,"supportsImageToImage":true},{"id":"gpt-image-2-4k","label":"GPT Image 2 4K","family":"chatgpt","enabled":true,"supportsTextToImage":true,"supportsImageToImage":true}]},{"id":"fastcode-gemini","label":"FastCode Gemini","type":"gemini-generate-content","baseUrl":"https://timebackward.com/v1beta","apiKeyEnv":"FASTCODE_API_KEY","authStyle":"api-key-header","models":[{"id":"gemini-3.1-flash-image-preview","label":"Gemini 3.1 Flash Image Preview","family":"gemini","enabled":true,"supportsTextToImage":true,"supportsImageToImage":true}]}]'
SUB2API_API_KEY="你的-provider-api-key"
FASTCODE_API_KEY=""
IMAGE_DAILY_LIMIT="20"

# SQLite 本地开发路径；不要指向或提交生产数据文件。
IMAGE_SERVICE_SQLITE_PATH="本地开发 SQLite 文件路径"
