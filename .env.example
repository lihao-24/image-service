# 仅填写本地或部署环境自己的值；不要提交真实密钥。

# Supabase Auth。只填写自己环境的 URL 和 anon key；不要提交真实值。
NEXT_PUBLIC_SUPABASE_URL="https://你的-supabase-域名"
NEXT_PUBLIC_SUPABASE_ANON_KEY="你的-supabase-anon-key"
# W04 登录边界只使用 anon key 和服务端 cookie session，不需要 service role key。

# image-service 服务端配置，由 W06 解析和校验。
IMAGE_DEFAULT_PROVIDER="sub2api"
IMAGE_DEFAULT_MODEL="gpt-image-2"
IMAGE_DEFAULT_SIZE="1024x1536"
IMAGE_DEFAULT_QUALITY="high"
IMAGE_DEFAULT_OUTPUT_FORMAT="png"
IMAGE_PROVIDER_OPTIONS='[{"id":"sub2api","label":"Sub2API","type":"openai-compatible-images","baseUrl":"https://你的-provider-base-url/v1","apiKeyEnv":"SUB2API_API_KEY","models":["gpt-image-2"]}]'
SUB2API_API_KEY="你的-provider-api-key"
IMAGE_SIZE_OPTIONS="1024x1024,1024x1536,1536x1024"
IMAGE_QUALITY_OPTIONS="high,medium,low"
IMAGE_OUTPUT_FORMAT_OPTIONS="png,jpeg,webp"
IMAGE_DAILY_LIMIT="20"

# SQLite 本地开发路径，由 W05 接入；不要指向或提交生产数据文件。
IMAGE_SERVICE_SQLITE_PATH="本地开发 SQLite 文件路径"
